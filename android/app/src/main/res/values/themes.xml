<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme. The app used to open straight onto Home with only a black window behind it,
         which read as the app "jumping into the menu" with no beginning. androidx.core.splashscreen
         backports the Android 12 splash to API 23+, so every device gets the same short beat on
         iron with the mark, then hands over to Theme.GymTracker. -->
    <style name="Theme.Forged.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.GymTracker</item>
    </style>

    <style name="Theme.GymTracker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
</resources>
