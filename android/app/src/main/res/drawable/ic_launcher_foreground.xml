<?xml version="1.0" encoding="utf-8"?>
<!-- Forged mark v10 "Chalk & Iron": the F, cut — an F built from struck bars whose mid-arm is
     sheared at 45°, like stock cut on the anvil. Replaces the v5 "Molten Dumbbell"
     (owner's call 2026-08-09: a dumbbell says "gym app" and every generator draws one).
     Chalk on iron; the single ember spark on the shear is the only warm pixel in the chrome.

     Placement: the mark occupies x 7..26.5, y 5.5..26.8 on its own 32-unit grid. Group pivot is
     0,0 so the transform is simply translate * scale(2.1). That puts the artwork at 41 x 44.7
     units with a ~61-unit diagonal, inside the 66dp adaptive-icon safe circle, centred on 54,54.
     Geometry matches ui/components/ForgedMark.kt — keep the two in step. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="2.1"
        android:scaleY="2.1"
        android:translateX="18.8"
        android:translateY="20.1">
        <!-- the F, cut -->
        <path
            android:fillColor="#EDE6D8"
            android:pathData="M7,5.5 L26.5,5.5 L26.5,11.2 L13.4,11.2 L13.4,15 L23,15 L18.4,20.4 L13.4,20.4 L13.4,26.8 L7,26.8 Z" />
        <!-- the spark off the shear: heat, used exactly once -->
        <path
            android:strokeColor="#FF5A1F"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M20.6,24 L26.6,24" />
    </group>
</vector>
