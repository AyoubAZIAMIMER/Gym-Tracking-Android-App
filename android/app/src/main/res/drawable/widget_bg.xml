<?xml version="1.0" encoding="utf-8"?>
<!-- Widget plate, v10 "Chalk & Iron": cold rolled iron, top-lit. The old plate washed its top
     edge in ember (#3A1608); chrome carries no hue now, so the only colour on the widget is the
     heat dot and the days-since figure, both driven from DarkHeat in ForgeWidgetProvider. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="90"
        android:startColor="#232221"
        android:centerColor="#191817"
        android:endColor="#0E0E0D" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#2C2A27" />
</shape>
